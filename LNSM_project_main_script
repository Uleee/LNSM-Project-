%% TASK 1: Data Association Error Analysis & Visualization (3D Matrix Version)

for i=1:N
    toa_slice=toa_errors(:,:,i); 
    aoa_slice=aoa_errors(:,:,i); 
    mean_toa_err(i)=mean(toa_slice,'all','omitnan'); 
    mean_az_err(i) = mean(aoa_slice(1, :), 'omitnan');
    mean_el_err(i) = mean(aoa_slice(2, :), 'omitnan');
end 

%% FIGURE 2: Per-Snapshot Mean Error Tracking
figure('Name', 'Mean Error Tracking (1 to 113)', 'Position', [100, 100, 1000, 700]);

subplot(3, 1, 1);
plot(1:N, mean_toa_err, 'r-o', 'LineWidth', 1.2, 'MarkerSize', 3, 'MarkerFaceColor', 'r');
grid on; xlim([1, N]);
ylabel('ToA Error (m)');
title('Average ToA Error per Snapshot');

subplot(3, 1, 2);
plot(1:N, mean_az_err, 'b-o', 'LineWidth', 1.2, 'MarkerSize', 3, 'MarkerFaceColor', 'b');
grid on; xlim([1, N]);
ylabel('Azimuth Error (deg)');
title('Average AoA Azimuth Error per Snapshot');

subplot(3, 1, 3);
plot(1:N, mean_el_err, 'g-o', 'LineWidth', 1.2, 'MarkerSize', 3, 'MarkerFaceColor', 'g');
grid on; xlim([1, N]);
xlabel('Snapshot Index (i)');
ylabel('Elevation Error (deg)');
title('Average AoA Elevation Error per Snapshot');

sgtitle('Overall Tracking Accuracy across 113 Snapshots');


